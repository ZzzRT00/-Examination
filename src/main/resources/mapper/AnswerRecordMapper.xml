<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhj.examination.mapper.AnswerRecordMapper">

    <insert id="insert">
        INSERT INTO answer_record(user_id,paper_id,total_score,user_score,create_time)
        VALUES(#{userId},#{paperId},#{totalScore},#{userScore},#{createTime})
    </insert>

    <select id="selectByUserId" resultType="com.xhj.examination.entity.AnswerRecord">
        SELECT id,user_id,paper_id,total_score,user_score,create_time
        FROM answer_record WHERE user_id = #{userId}
    </select>

    <select id="selectByPaperId" resultType="com.xhj.examination.entity.AnswerRecord">
        SELECT id,user_id,paper_id,total_score,user_score,create_time
        FROM answer_record WHERE paper_id = #{paperId}
    </select>
</mapper>